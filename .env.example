# Database
POSTGRES_PASSWORD=change-me-strong-password

# API security
API_KEY_ADMIN=change-me-admin-key

# App settings
LOG_LEVEL=INFO
APP_ENV=production

# Compose project
COMPOSE_PROJECT_NAME=ecommerce-platform

# AWS & S3 Cloud Backup Settings (Optional - leave blank for local storage)
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-ecommerce-platform-backups
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_ENDPOINT_URL=http://localhost:4566  # Use for LocalStack / MinIO local dev
